# Optional: if empty, frontend sends to /send.php (same host)
VITE_CONTACT_FORM_ENDPOINT=

# Optional public asset delivery origin (HTTPS only). Empty keeps assets on the site.
# Production uses https://ray-stream-twice322s-projects.vercel.app
VITE_ASSET_ORIGIN=

# For PHP handler (send.php) on hosting environment
CONTACT_EMAIL=info@raystream.hk

# Vercel Node handler (server-only)
RESEND_API_KEY=
CONTACT_FROM=Raystream <no-reply@raystream.hk>
