{
  "name": "raystream",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-pages.mjs",
    "typecheck": "tsc --noEmit",
    "check:catalog": "node scripts/check-catalog.mjs",
    "check:contact": "node scripts/check-contact.cjs",
    "check:model": "node scripts/check-model-selection.cjs",
    "preview": "vite preview",
    "start": "vite preview --host --port 3000",
    "build:vercel": "npm run build && node -e \"require('node:fs').rmSync('dist/send.php', {force:true})\""
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "1.4.0",
    "class-variance-authority": "0.7.1",
    "classnames": "^2.5.1",
    "d3-geo": "^3.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/topojson-client": "^3.1.4",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
